<?xml version="1.0" encoding="utf-8"?>
<Project DefaultTargets="Build">
  <Sdk Name="Microsoft.Build.Sql" Version="2.3.0" />
  <PropertyGroup>
    <Name>ReportingDB</Name>
    <DSP>Microsoft.Data.Tools.Schema.Sql.Sql160DatabaseSchemaProvider</DSP>
    <ModelCollation>1033, CI</ModelCollation>
    <ProjectGuid>B2D12F51-2868-4E77-B580-902235DA52A1</ProjectGuid>

    <!-- NuGet package metadata (used by dotnet pack) -->
    <PackageId>ReportingDB.Package</PackageId>
    <Authors>Prasad</Authors>
    <Description>ReportingDB DACPAC and deployment script for Octopus Deploy</Description>
    <PackageTags>database dacpac sqlserver reportingdb</PackageTags>
    <!-- SDK auto-places dacpac in tools/ — no override needed -->
  </PropertyGroup>

  <ItemGroup>
    <Folder Include="dbo" />
    <Folder Include="dbo\StoredProcedures" />
    <Folder Include="dbo\Tables" />
  </ItemGroup>

  <!-- Deploy.ps1 at package root; dacpac goes to tools/ automatically via SDK -->
  <ItemGroup>
    <None Include="Deploy.ps1">
      <Pack>true</Pack>
      <PackagePath></PackagePath>
    </None>
    <None Include="bin\$(Configuration)\BankingDB.dacpac" Condition="Exists('bin\$(Configuration)\BankingDB.dacpac')">
      <Pack>true</Pack>
      <PackagePath>tools\</PackagePath>
    </None>
  </ItemGroup>

  <!-- BankingDB reference -->
  <ItemGroup>
    <SqlCmdVariable Include="BankingDB">
      <Value>$(BankingDatabaseName)</Value>
      <DefaultValue>BankingDB</DefaultValue>
    </SqlCmdVariable>
    <SqlCmdVariable Include="BankingDBServer">
      <Value>$(BankingDBLinkServerName)</Value>
      <DefaultValue>localhost</DefaultValue>
    </SqlCmdVariable>
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\BankingDB\BankingDB.sqlproj">
      <Name>BankingDB</Name>
      <Project>A703A26E-3890-4CD2-830B-CDC6F679D5B6</Project>
      <Private>True</Private>
      <SuppressMissingDependenciesErrors>False</SuppressMissingDependenciesErrors>
      <DatabaseSqlCmdVariable>BankingDB</DatabaseSqlCmdVariable>
      <ServerSqlCmdVariable>BankingDBServer</ServerSqlCmdVariable>
    </ProjectReference>
  </ItemGroup>

</Project>
