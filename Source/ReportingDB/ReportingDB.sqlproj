<?xml version="1.0" encoding="utf-8"?>
<Project DefaultTargets="Build">
  <Sdk Name="Microsoft.Build.Sql" Version="2.3.0" />
  <PropertyGroup>
    <Name>ReportingDB</Name>
    <DSP>Microsoft.Data.Tools.Schema.Sql.Sql170DatabaseSchemaProvider</DSP>
    <ModelCollation>1033, CI</ModelCollation>
    <ProjectGuid>B2D12F51-2868-4E77-B580-902235DA52A1</ProjectGuid>
  </PropertyGroup>
  <ItemGroup>
    <Folder Include="dbo" />
    <Folder Include="dbo\StoredProcedures" />
    <Folder Include="dbo\Tables" />
  </ItemGroup>

  <!-- BankingDB reference -->
  <ItemGroup>
    <SqlCmdVariable Include="BankingDB">
      <Value>$(BankingDatabaseName)</Value>
      <DefaultValue>BankingDB</DefaultValue>
    </SqlCmdVariable>
    <SqlCmdVariable Include="BankingDBServer">
      <Value>$(BankingDBLinkServerName)</Value>
      <DefaultValue>localhost</DefaultValue>
    </SqlCmdVariable>
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\BankingDB\BankingDB.sqlproj">
      <Name>BankingDB</Name>
      <Project>A703A26E-3890-4CD2-830B-CDC6F679D5B6</Project>
      <Private>True</Private>
      <SuppressMissingDependenciesErrors>False</SuppressMissingDependenciesErrors>
      <DatabaseSqlCmdVariable>BankingDB</DatabaseSqlCmdVariable>
      <ServerSqlCmdVariable>BankingDBServer</ServerSqlCmdVariable>
    </ProjectReference>
  </ItemGroup>

</Project>