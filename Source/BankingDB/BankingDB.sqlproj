<?xml version="1.0" encoding="utf-8"?>
<Project DefaultTargets="Build">
  <Sdk Name="Microsoft.Build.Sql" Version="2.3.0" />
  <PropertyGroup>
    <Name>BankingDB</Name>
    <DSP>Microsoft.Data.Tools.Schema.Sql.Sql160DatabaseSchemaProvider</DSP>
    <ModelCollation>1033, CI</ModelCollation>
    <ProjectGuid>A703A26E-3890-4CD2-830B-CDC6F679D5B6</ProjectGuid>

    <!-- NuGet package metadata (used by dotnet pack) -->
    <PackageId>BankingDB.Package</PackageId>
    <Authors>Prasad</Authors>
    <Description>BankingDB DACPAC and deployment script for Octopus Deploy</Description>
    <PackageTags>database dacpac sqlserver bankingdb</PackageTags>

    <!-- Put dacpac inside content/ instead of tools/ -->
    <BuildOutputTargetFolder>content</BuildOutputTargetFolder>
  </PropertyGroup>
  <ItemGroup>
    <Folder Include="dbo" />
    <Folder Include="dbo\StoredProcedures" />
    <Folder Include="dbo\Tables" />
  </ItemGroup>

  <!-- Include Deploy.ps1 inside the NuGet package -->
  <ItemGroup>
    <None Include="Deploy.ps1">
      <Pack>true</Pack>
      <PackagePath></PackagePath>
    </None>
  </ItemGroup>

</Project>